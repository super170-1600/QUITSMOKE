# Select one backend. Keep supabase for rollback or use cloudbase for migration testing.
VITE_BACKEND_PROVIDER=supabase

# Supabase Project Settings -> API (kept for rollback)
VITE_SUPABASE_URL=
# Browser-safe anon/publishable value only. Never use service_role or a secret key.
VITE_SUPABASE_ANON_KEY=

# Tencent CloudBase PostgreSQL Web SDK
VITE_CLOUDBASE_ENV_ID=quitsmoke-d0gl5n5ge1297c2b5
# Browser-safe Publishable Key only. Never use an API Key/service-role credential.
VITE_CLOUDBASE_PUBLISHABLE_KEY=
# Optional; defaults to ap-shanghai.
VITE_CLOUDBASE_REGION=ap-shanghai

# Local/test-only utilities. Keep false or unset in production.
VITE_ENABLE_DEV_TOOLS=false
